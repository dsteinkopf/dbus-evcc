#!/bin/sh
# BASH_SOURCE and &> are bash-only in a #!/bin/sh script; they work today only
# because /bin/sh is bash on Venus OS.
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

exec 2>&1
# realpath keeps the absolute form restart.sh greps for via pgrep -f
exec python "$(realpath "$SCRIPT_DIR/../dbus-evcc.py")"
